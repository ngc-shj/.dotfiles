[core]
	pager = less -cm
	quotepath = false
	editor = vim

[user]
	name = NOGUCHI Shoji
	email = github.com@jpng.jp

[credential]
	helper = cache --timeout=86400

; gh is resolved from PATH so the same config works on both Homebrew
; prefixes (/opt/homebrew on macOS, /home/linuxbrew/.linuxbrew on Linux).
; The empty helper resets the inherited cache helper above for these hosts.
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[ghq]
	root = ~/ghq

[github]
	user = ngc-shj

[includeIf "hasconfig:remote.*.url:ssh://git@github.com/**"]
	path = ~/.config/git/github.conf

[includeIf "hasconfig:remote.*.url:https://github.com/**"]
	path = ~/.config/git/github.conf

[includeIf "hasconfig:remote.*.url:ssh://git@hf.co/**"]
	path = ~/.config/git/huggingface.conf

[includeIf "hasconfig:remote.*.url:https://huggingface.co/**"]
	path = ~/.config/git/huggingface.conf
